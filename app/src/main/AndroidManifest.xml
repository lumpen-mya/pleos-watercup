<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK: 조회 권한만 사용 (차량 제어 권한 없음) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <!-- Pleos TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- Pleos NaviHelper SDK: 길 안내 정보 조회만 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- Android Automotive 표준 차량 속도 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaterCup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <!-- 주행 중에도 표시되는 화면: 조작 요소 없이 컵과 숫자만 보여 준다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
